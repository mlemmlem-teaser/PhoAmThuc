@* Các khuôn HTML dùng lại nhiều lần. JavaScript nhân bản chúng rồi điền dữ liệu (xem postcard.js, pager.js) *@

<template id="LabelChipTemplate">
    <span class="labelchip"></span>
</template>

<template id="PagerLinkTemplate">
    <a class="pagerlink"></a>
</template>

<template id="PostCardTemplate">
    <article class="postcard">
        <a class="postimagelink">
            <img class="postimage" alt="" />
            <span class="imageholder">Phố Ẩm Thực</span>
        </a>
        <div class="postinfo">
            <div class="postlabels"></div>
            <h2 class="posttitle"><a class="postlink"></a></h2>
            <p class="postsummary"></p>
            <p class="postmeta">
                <a class="postauthor"></a>
                <span class="postdate"></span>
                <span class="postupdated"></span>
            </p>
            <p class="postmeta">
                <span class="postrating"></span>
                <span class="postviews"></span>
            </p>
            <a class="outlinebutton postbutton">Xem bài đăng</a>
        </div>
    </article>
</template>
